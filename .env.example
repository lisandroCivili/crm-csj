# Postgres. En desarrollo: npx prisma dev. En produccion: la URL de Railway.
DATABASE_URL="postgres://usuario:password@host:5432/basededatos"
SHADOW_DATABASE_URL="postgres://usuario:password@host:5432/basededatos_shadow"

# Auth.js. Generar con: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Directorio de adjuntos. En Railway apunta al mount del volumen persistente.
UPLOADS_DIR="./uploads"

# Solo desarrollo. Hosts extra desde los que se puede entrar al server ademas de
# localhost, separados por coma: la IP de la maquina en la red de casa, otro
# tunel. Los dominios de ngrok ya estan en next.config.ts. Sin esto, next dev
# responde 403 a los chunks de /_next y la pagina no hidrata.
ORIGENES_DEV=""
