# Postgres. En desarrollo: npx prisma dev. En produccion: la URL de Railway.
DATABASE_URL="postgres://usuario:password@host:5432/basededatos"
SHADOW_DATABASE_URL="postgres://usuario:password@host:5432/basededatos_shadow"

# Auth.js. Generar con: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# Directorio de adjuntos. En Railway apunta al mount del volumen persistente.
UPLOADS_DIR="./uploads"
