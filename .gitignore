# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# datos sensibles: los padrones reales traen nombre, DNI, domicilio,
# telefono y email de clientes reales. NUNCA versionarlos.
/docs/*.xls
/docs/*.xlsx
/docs/*.csv

# padrones de prueba: son ficticios, pero se regeneran con
# `npx tsx scripts/generar-padrones-prueba.ts` y no vale la pena versionar
# binarios que salen de un script.
/docs/padrones-prueba

# adjuntos subidos (foto de DNI, contratos) -> volumen de Railway
/uploads

# prisma: cliente generado
/lib/generated

# skills de terceros instaladas por la CLI de prisma (se regeneran desde
# skills-lock.json). .claude/skills/prisma-* son symlinks hacia .agents/
/.agents
/.claude/skills/prisma-*

# typescript
*.tsbuildinfo
next-env.d.ts

# capturas de pantalla de desarrollo
/.capturas
/.capturas-movil
