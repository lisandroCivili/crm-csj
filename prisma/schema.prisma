// CRM Club San Jorge — Balta
// Ver CLAUDE.md para el vocabulario del dominio y las reglas de negocio.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  VENDEDOR
}

enum ZonaNombre {
  SALTA
  TUCUMAN
}

/// Los leads que el club le deriva al agente vs. los que Balta genera por su
/// cuenta (campañas propias de Meta Ads).
enum LeadOrigen {
  CLUB
  PROPIO
}

enum LeadEstado {
  PENDIENTE
  VENDIDO
  NO_VENDIDO
  DEVOLUCION
}

enum LeadActividadTipo {
  ASIGNACION
  CAMBIO_ESTADO
}

enum VentaEstado {
  ACTIVA
  ANULADA
}

enum AdjuntoTipo {
  DNI
  CONTRATO
}

enum ComisionEstado {
  BORRADOR
  CERRADO
}

/// Como entro un titulo al sistema. Se sella cuando se lo ve por primera vez y
/// despues no cambia.
///
/// - `VENTA_NUEVA`: aparecio con cuota 1, es una venta del mes.
/// - `RENOVACION`: aparecio con cuota > 1. El cliente ya venia pagando en otro
///   lado (o el club lo paso de agencia). No suma al volumen del tramo, pero
///   sus cuotas se comisionan normal.
/// - `BASE`: venia de antes del sistema. Es lo que trae la primera importacion
///   de la zona, donde todavia no hay con que comparar.
enum TituloOrigen {
  VENTA_NUEVA
  RENOVACION
  BASE
}

// ---------------------------------------------------------------------------
// Base: zonas y usuarios
// ---------------------------------------------------------------------------

/// Salta o Tucuman. El admin elige una despues de loguearse y esa eleccion
/// filtra absolutamente todo lo que ve y carga.
model Zona {
  id     Int        @id @default(autoincrement())
  nombre ZonaNombre @unique

  /// Contratos que el club le exige al agente por mes para que aplique la
  /// escala del contrato de agencia (Balta, 27/08/2026: Tucuman 50, Salta 100).
  /// Cuentan las ventas nuevas Y las renovaciones. Si no se llega, la
  /// liquidacion avisa pero calcula igual: todavia no esta definido a que
  /// esquema se vuelve.
  objetivoContratosMensual Int @default(50)

  vendedores       Vendedor[]
  clientes         Cliente[]
  titulos          Titulo[]
  leads            Lead[]
  leadImports      LeadImport[]
  padronImports    PadronImport[]
  ventas           Venta[]
  comisiones       ComisionPeriodo[]
  escalaAgente     EscalaAgente[]
  comisionesAgente ComisionAgentePeriodo[]

  @@map("zonas")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nombre       String
  role         Role
  /// Si esta en false no puede iniciar sesion. Es distinto de `Vendedor.activo`:
  /// esto le saca el acceso al sistema, aquello lo saca del equipo de venta.
  activo       Boolean  @default(true)
  /// Solo para admins: el telefono de un vendedor vive en su ficha (`Vendedor`),
  /// que es la que mira Balta.
  telefono     String?
  /// Codigo con el que el club identifica al agente. Es de la persona, no de la
  /// zona: Balta es el mismo agente en Salta y en Tucuman. No confundir con
  /// `Vendedor.codigo`, que si es por zona y es el codigo del vendedor.
  /// Texto y no entero: es un identificador, no una cantidad.
  codigoAgente String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  /// Una ficha por zona. Un vendedor comun tiene una sola; Balta y Pedro tienen
  /// una en Salta y otra en Tucuman.
  vendedores Vendedor[]

  padronImports     PadronImport[]
  leadImports       LeadImport[]
  leadActividades   LeadActividad[]
  adjuntosSubidos   VentaAdjunto[]
  historialesVentas VentaHistorial[]
  clientesEditados  Cliente[]
  ventasAnuladas    Venta[]          @relation("VentasAnuladas")

  @@map("usuarios")
}

/// Un vendedor puede existir SIN cuenta de usuario: hay vendedores que figuran
/// en el padron del club pero no usan el sistema. La cuenta es opcional.
///
/// La ficha es POR ZONA: Balta y Pedro venden en Salta y en Tucuman, asi que la
/// misma persona tiene una ficha en cada una. Por eso el DNI es unico dentro de
/// la zona y no en toda la tabla (igual que `Cliente`), y por eso `userId` no
/// es unico: una cuenta puede estar atada a varias fichas, una por zona.
model Vendedor {
  id             String  @id @default(cuid())
  nombreCompleto String
  dni            String
  codigo         String
  direccion      String?
  email          String?
  telefono       String?

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  /// Hasta que numero de cuota cobra comision este vendedor (1 a 5).
  /// Lo define Balta por vendedor.
  topeCuotasComision Int     @default(4)
  condiciones        String?

  /// Escala de comision asignada. Si es null, se le aplica la escala marcada
  /// como predeterminada (ver `Escala.esPredeterminada`).
  escalaId String?
  escala   Escala? @relation(fields: [escalaId], references: [id])

  // --- Permisos ------------------------------------------------------------
  // Que secciones ve el vendedor cuando entra. El permiso se SACA, no se da:
  // por defecto ve todo, asi los vendedores que ya existen no cambian de
  // comportamiento con la migracion. Los define el admin desde la ficha del
  // vendedor; el vendedor no puede tocarlos.
  //
  // No viajan en la sesion: se leen de la base en cada request (ver
  // lib/sesion.ts), porque el JWT del vendedor no se entera de que el admin le
  // cambio un permiso.
  puedeVerLeads     Boolean @default(true)
  puedeCargarVentas Boolean @default(true)
  /// Solo visibilidad: no afecta el calculo ni la liquidacion. El vendedor
  /// cobra igual, simplemente no ve el numero.
  puedeVerComision  Boolean @default(true)

  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  alias      VendedorAlias[]
  titulos    Titulo[]
  leads      Lead[]
  ventas     Venta[]
  comisiones ComisionPeriodo[]

  @@unique([zonaId, codigo])
  @@unique([zonaId, dni])
  @@index([zonaId])
  @@index([userId])
  @@index([escalaId])
  @@map("vendedores")
}

/// `NomVen` en el padron es texto libre y sucio: el mismo vendedor aparece
/// escrito de varias formas (TOLEDO PEDRO / TOLEDO PEDRO A. / TOLEDO PEDRO
/// ANTONIO son la misma persona). Esta tabla mapea cada variante al vendedor
/// real. `nomVenPadron` se guarda normalizado (mayusculas, sin espacios extra).
model VendedorAlias {
  id           String   @id @default(cuid())
  nomVenPadron String   @unique
  vendedorId   String
  vendedor     Vendedor @relation(fields: [vendedorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([vendedorId])
  @@map("vendedores_alias")
}

// ---------------------------------------------------------------------------
// Padron (nucleo del sistema)
// ---------------------------------------------------------------------------

/// Un lote de importacion de padron. Nunca se pisan: queda el historico
/// completo para poder auditar de donde salio cada dato.
model PadronImport {
  id                  String    @id @default(cuid())
  archivoNombre       String
  zonaId              Int
  zona                Zona      @relation(fields: [zonaId], references: [id])
  fechaEmisionArchivo DateTime?
  periodoDesde        DateTime?
  periodoHasta        DateTime?

  filasLeidas          Int @default(0)
  clientesNuevos       Int @default(0)
  clientesActualizados Int @default(0)
  titulosNuevos        Int @default(0)
  titulosActualizados  Int @default(0)
  cuotasNuevas         Int @default(0)
  cuotasActualizadas   Int @default(0)
  /// Filas que ya estaban cargadas identicas. Con el solape de 3 meses del
  /// padron son la mayoria, y verlas confirma que el upsert no duplico nada.
  cuotasSinCambios     Int @default(0)
  /// Cuotas que pasaron de impagas a pagadas en esta importacion: es la
  /// materia prima del calculo de comisiones.
  cuotasReciePagadas   Int @default(0)

  /// De los `titulosNuevos`, cuantos entraron con cuota 1 (venta del mes) y
  /// cuantos con cuota mayor (renovacion). En una linea base los dos son 0.
  titulosNuevosVenta      Int     @default(0)
  titulosNuevosRenovacion Int     @default(0)
  /// Primera importacion de la zona: no hay padron anterior contra el cual
  /// comparar, asi que todos sus titulos quedan como BASE y no se puede saber
  /// cuales eran ventas nuevas.
  esLineaBase             Boolean @default(false)

  importadoPorUserId String
  importadoPor       User     @relation(fields: [importadoPorUserId], references: [id])
  createdAt          DateTime @default(now())

  titulos Titulo[]
  cuotas  TituloCuota[]

  @@index([zonaId])
  @@map("padron_imports")
}

/// El padron del club es la fuente de estos datos. Un cliente puede tener
/// varios titulos (en el padron analizado, 278 de 2007 clientes tenian mas
/// de un plan).
model Cliente {
  id        String  @id @default(cuid())
  dni       String
  nombre    String
  domicilio String?
  telefono  String?
  codPos    String?
  localidad String?
  email     String?

  /// Datos personales que el admin corrigio a mano. El padron deja de tocarlos:
  /// si el club los tiene mal, el dato bueno es el corregido. Se guarda como
  /// array y no como seis booleanos para no migrar cada vez que aparezca un
  /// campo nuevo. Los valores validos estan en `lib/padron/camposCliente.ts`.
  camposManuales String[] @default([])

  editadoPorUserId String?
  editadoPor       User?     @relation(fields: [editadoPorUserId], references: [id])
  editadoAt        DateTime?

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  titulos Titulo[]

  @@unique([zonaId, dni])
  @@index([zonaId])
  @@index([nombre])
  @@map("clientes")
}

/// `NumTit` identifica de forma unica al contrato/suscripcion. En el padron
/// analizado ningun titulo cambiaba de DNI ni de vendedor.
model Titulo {
  id     String @id @default(cuid())
  numTit String @unique

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  vendedorId String?
  vendedor   Vendedor? @relation(fields: [vendedorId], references: [id])

  /// Numero de sorteo (0-999).
  numSor           String?
  debitoAutomatico Boolean  @default(false)
  codDistribucion  String?
  nomDistribucion  String?
  rescate          Decimal? @db.Decimal(14, 2)
  cuotasPagas      Int?

  /// Como entro al sistema. Se decide en la importacion que lo trajo por
  /// primera vez y no se vuelve a tocar.
  origen       TituloOrigen @default(BASE)
  /// Numero de cuota mas bajo con el que se lo vio. Es lo que define el origen:
  /// 1 = venta nueva, mayor = renovacion.
  cuotaInicial Int?

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  activo          Boolean   @default(true)
  /// Ultima vez que el titulo aparecio en un padron. Si deja de aparecer en
  /// importaciones nuevas, es candidato a baja.
  vistoEnPadronAt DateTime?

  // --- Caidas (ver lib/padron/caidas.ts) -----------------------------------
  // Todo esto es derivado del historico de cuotas: se recalcula despues de cada
  // importacion y con scripts/recalcular-caidas.ts. Se guarda porque hace falta
  // filtrar y contar por estado sin recorrer millones de cuotas.

  /// Cuotas impagas consecutivas al final del historico conocido.
  impagasConsecutivas Int       @default(0)
  /// Numero de la ultima cuota que algun padron mostro pagada.
  cuotaUltimaPaga     Int?
  /// Entre estas dos cuotas es lo que el sistema llego a ver del titulo.
  cuotaMinConocida    Int?
  cuotaMaxConocida    Int?
  /// Cuando el sistema lo dio por caido. Null = no esta caido.
  caidoAt             DateTime?
  /// El historico alcanza para afirmar el estado. False = "sin datos
  /// suficientes": hay un hueco en la numeracion o la racha llega al borde de
  /// lo que conocemos, y afirmar una caida ahi seria inventarla.
  caidaConfiable      Boolean   @default(false)

  ultimoPadronImportId String?
  ultimoPadronImport   PadronImport? @relation(fields: [ultimoPadronImportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cuotas TituloCuota[]
  ventas Venta[]

  @@index([clienteId])
  @@index([vendedorId])
  @@index([zonaId])
  @@index([zonaId, caidoAt])
  @@map("titulos")
}

/// Una fila del padron = una cuota de un titulo en un mes (`periodoEmision`).
///
/// REGLA CENTRAL DEL SISTEMA: la clave unica es (tituloId, numeroCuota). El
/// padron trae 3 meses por titulo y padrones sucesivos pueden solaparse, asi
/// que la importacion SIEMPRE es un upsert sobre esta clave, nunca un append.
/// Reimportar el mismo archivo no debe duplicar ni alterar nada.
model TituloCuota {
  id          String @id @default(cuid())
  tituloId    String
  titulo      Titulo @relation(fields: [tituloId], references: [id], onDelete: Cascade)
  numeroCuota Int

  periodoEmision DateTime
  importe        Decimal  @db.Decimal(14, 2)

  /// Vacio = cuota impaga (columna FchPago del padron).
  fechaPago DateTime?
  detalle   String?
  boni      String?
  anti      String?

  /// Momento en que el sistema vio por primera vez esta cuota como pagada.
  /// Dispara el devengamiento de comision del periodo correspondiente.
  detectadaPagaAt DateTime?

  padronImportId String?
  padronImport   PadronImport? @relation(fields: [padronImportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comisionDetalles ComisionDetalle[]

  @@unique([tituloId, numeroCuota])
  @@index([periodoEmision])
  @@index([fechaPago])
  @@index([detectadaPagaAt])
  @@map("titulo_cuotas")
}

// ---------------------------------------------------------------------------
// Leads
// ---------------------------------------------------------------------------

model LeadImport {
  id            String     @id @default(cuid())
  archivoNombre String
  origen        LeadOrigen
  zonaId        Int
  zona          Zona       @relation(fields: [zonaId], references: [id])
  cantidad      Int        @default(0)

  importadoPorUserId String
  importadoPor       User     @relation(fields: [importadoPorUserId], references: [id])
  createdAt          DateTime @default(now())

  leads Lead[]

  @@index([zonaId])
  @@map("lead_imports")
}

model Lead {
  id        String  @id @default(cuid())
  nombre    String
  telefono  String?
  direccion String?
  localidad String?
  provincia String?

  origen           LeadOrigen
  estado           LeadEstado @default(PENDIENTE)
  /// Motivo cuando el vendedor devuelve el lead.
  motivoDevolucion String?

  vendedorAsignadoId String?
  vendedorAsignado   Vendedor? @relation(fields: [vendedorAsignadoId], references: [id])
  fechaAsignacion    DateTime?

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  leadImportId String?
  leadImport   LeadImport? @relation(fields: [leadImportId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actividades LeadActividad[]
  ventas      Venta[]

  @@index([zonaId, estado])
  @@index([vendedorAsignadoId])
  @@map("leads")
}

/// Log de asignaciones y cambios de estado. Los admins tienen que poder ver
/// todo lo que hacen los vendedores sobre sus leads.
model LeadActividad {
  id     String            @id @default(cuid())
  leadId String
  lead   Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tipo   LeadActividadTipo

  estadoAnterior LeadEstado?
  estadoNuevo    LeadEstado?
  detalle        String?

  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_actividades")
}

// ---------------------------------------------------------------------------
// Planes y ventas
// ---------------------------------------------------------------------------

model Plan {
  id             String  @id @default(cuid())
  /// Codigo de producto de 3 digitos.
  codigoProducto String  @unique
  nombre         String
  duracionMeses  Int?
  activo         Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  precios PlanPrecio[]
  ventas  Venta[]

  @@map("planes")
}

/// Historico de precios: al recargar la lista no se pisa el precio con el que
/// se vendio en el pasado.
model PlanPrecio {
  id           String   @id @default(cuid())
  planId       String
  plan         Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  precio       Decimal  @db.Decimal(14, 2)
  vigenteDesde DateTime
  createdAt    DateTime @default(now())

  @@unique([planId, vigenteDesde])
  @@index([planId])
  @@map("plan_precios")
}

/// Venta cargada por el vendedor. Es su pipeline: existe antes de que el club
/// asigne el numero de titulo. `tituloId` se completa cuando el titulo aparece
/// en un padron y se vincula.
model Venta {
  id String @id @default(cuid())

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id])

  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  nombreCliente String
  dni           String
  /// "Calle Nro y Barrio" en el formulario.
  direccion     String?
  telefono      String?

  /// Localidad, provincia y debito automatico salieron del formulario cuando
  /// Balta definio los campos (27/08/2026). Las columnas se conservan porque
  /// las ventas viejas las tienen cargadas y borrarlas seria perder ese dato;
  /// no se piden mas al cargar una venta.
  localidad String?
  provincia String?

  /// Numero de suscripcion que le da el club a la venta. Es el identificador
  /// hasta que el club asigna el titulo definitivo; por eso deja de ser
  /// obligatorio cuando `numeroTitulo` esta cargado.
  nroSuscripcion String?
  /// `NumTit` del padron, cuando el club ya lo asigno. Se guarda como texto y
  /// no como relacion a `Titulo`: al cargar la venta ese titulo todavia no
  /// existe en el sistema, porque llega recien con el padron siguiente.
  numeroTitulo   String?
  /// Texto libre del vendedor. Obligatorio mientras la venta se identifique
  /// por numero de suscripcion.
  observacion    String?

  planId           String?
  plan             Plan?   @relation(fields: [planId], references: [id])
  codigoProducto   String?
  debitoAutomatico Boolean @default(false)

  estado     VentaEstado @default(ACTIVA)
  fechaVenta DateTime    @default(now())

  /// Anulacion. La venta no se borra: se marca, se guarda quien la anulo y por
  /// que, y se sigue viendo atenuada en los listados. Borrarla perderia el
  /// historial y los adjuntos, y ademas nadie sabria que existio.
  anuladaAt        DateTime?
  anuladaPorUserId String?
  anuladaPor       User?     @relation("VentasAnuladas", fields: [anuladaPorUserId], references: [id])
  motivoAnulacion  String?

  tituloId String?
  titulo   Titulo? @relation(fields: [tituloId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  adjuntos         VentaAdjunto[]
  historial        VentaHistorial[]
  comisionDetalles ComisionDetalle[]

  @@index([vendedorId])
  @@index([zonaId])
  @@index([dni])
  @@map("ventas")
}

/// La foto de DNI es obligatoria (se valida en la aplicacion) y el contrato es
/// opcional. Los archivos viven en el volumen de Railway y se sirven por
/// /api/uploads/[id], que valida sesion y permiso.
model VentaAdjunto {
  id       String      @id @default(cuid())
  ventaId  String
  venta    Venta       @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  tipo     AdjuntoTipo
  path     String
  mimeType String
  size     Int

  subidoPorUserId String
  subidoPor       User     @relation(fields: [subidoPorUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([ventaId])
  @@map("venta_adjuntos")
}

/// Un registro por edicion, con el diff completo { campo: { antes, despues } }.
model VentaHistorial {
  id      String @id @default(cuid())
  ventaId String
  venta   Venta  @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  cambios Json

  modificadoPorUserId String
  modificadoPor       User     @relation(fields: [modificadoPorUserId], references: [id])
  createdAt           DateTime @default(now())

  @@index([ventaId])
  @@map("venta_historial")
}

// ---------------------------------------------------------------------------
// Comisiones
//
// La comision se liquida desde el PADRON, no desde las ventas cargadas en el
// CRM (confirmado por Balta el 2026-08-12). El porcentaje se aplica sobre el
// importe de las cuotas que el padron mostro cobradas en el mes, agrupadas por
// numero de cuota. Ver lib/comisiones/calcularComisionPeriodo.ts.
// ---------------------------------------------------------------------------

/// Una escala con nombre, asignable por vendedor. Se mantienen los dos ejes de
/// siempre (tramos de ventas del mes x % por cuota); lo que cambia es que
/// puede haber varias y cada vendedor se asigna a una (`Vendedor.escalaId`).
/// No tiene `zonaId`: las escalas se comparten entre Salta y Tucuman, es el
/// vendedor el que esta por zona.
model Escala {
  id               String   @id @default(cuid())
  nombre           String
  /// La que se le aplica a un vendedor sin escala asignada. Solo una a la vez
  /// (se controla en la server action, no con un unique parcial).
  esPredeterminada Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  filas      EscalaComision[]
  vendedores Vendedor[]

  @@map("escalas")
}

/// Tabla de tramos editable desde la UI: cruza el volumen de ventas nuevas del
/// mes contra el numero de cuota, dentro de una escala. NUNCA hardcodear
/// porcentajes.
model EscalaComision {
  id          String   @id @default(cuid())
  escalaId    String
  escala      Escala   @relation(fields: [escalaId], references: [id], onDelete: Cascade)
  ventasMin   Int
  /// null = sin tope superior.
  ventasMax   Int?
  numeroCuota Int
  porcentaje  Decimal  @db.Decimal(6, 3)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([escalaId, ventasMin, numeroCuota])
  @@index([escalaId])
  @@map("escalas_comision")
}

model ComisionPeriodo {
  id String @id @default(cuid())

  vendedorId String
  vendedor   Vendedor @relation(fields: [vendedorId], references: [id])

  /// Formato YYYY-MM.
  periodo String

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  /// Ventas nuevas (cuotas 1 cobradas) del mes. Es el volumen que definio el
  /// tramo de escala: se mide por periodo, no por acumulado historico.
  ventasDelPeriodo Int @default(0)

  totalComisionCuotas  Decimal @default(0) @db.Decimal(14, 2)
  /// Importe que Balta agrega a mano a la comision del periodo.
  gastosRepresentacion Decimal @default(0) @db.Decimal(14, 2)
  totalComision        Decimal @default(0) @db.Decimal(14, 2)

  estado      ComisionEstado @default(BORRADOR)
  fechaCierre DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalles ComisionDetalle[]

  @@unique([vendedorId, periodo])
  @@index([zonaId])
  @@map("comision_periodos")
}

/// Un renglon de la liquidacion: todas las cuotas del mismo numero que el
/// vendedor cobro en el periodo, con la base sumada y el porcentaje congelado.
model ComisionDetalle {
  id                String          @id @default(cuid())
  comisionPeriodoId String
  comisionPeriodo   ComisionPeriodo @relation(fields: [comisionPeriodoId], references: [id], onDelete: Cascade)

  /// Sin uso: el renglon agrupa varias cuotas, no una sola. Se conserva por si
  /// alguna vez hace falta liquidar cuota por cuota.
  tituloCuotaId String?
  tituloCuota   TituloCuota? @relation(fields: [tituloCuotaId], references: [id])

  /// Sin uso: la comision sale del padron, `Venta` no interviene en el calculo.
  ventaId String?
  venta   Venta?  @relation(fields: [ventaId], references: [id])

  numeroCuota        Int
  /// Cuantas cuotas de ese numero entraron en el renglon.
  cantidadCuotas     Int     @default(0)
  baseCalculo        Decimal @db.Decimal(14, 2)
  /// Porcentaje congelado al momento del calculo: si Balta cambia la escala
  /// despues, los periodos ya cerrados no se recalculan solos.
  porcentajeAplicado Decimal @db.Decimal(6, 3)
  monto              Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([comisionPeriodoId])
  @@map("comision_detalles")
}

// ---------------------------------------------------------------------------
// Comision del agente
//
// Lo que el CLUB le paga a la agencia, distinto de lo que la agencia le paga a
// sus vendedores. Misma materia prima (las cuotas que el padron mostro
// cobradas) y mismo devengamiento (`detectadaPagaAt`), pero otras reglas:
//
//   - Toma TODAS las cuotas de la zona, sin filtrar por vendedor.
//   - NO tiene tope de cuota 5: el contrato paga hasta la ultima cuota.
//   - Un solo eje: el numero de cuota. El volumen del mes no mueve el
//     porcentaje, solo define si se llega al objetivo del contrato.
//
// Ver lib/comisiones/calcularComisionAgente.ts.
// ---------------------------------------------------------------------------

/// Tramo del contrato de agencia: que porcentaje paga el club por una cuota
/// segun su numero. Es por zona porque el objetivo mensual difiere y porque un
/// contrato podria cambiar sin arrastrar al otro; hoy Balta y Pedro tienen el
/// mismo (adenda del 13/01/2023). NUNCA hardcodear porcentajes.
model EscalaAgente {
  id     String @id @default(cuid())
  zonaId Int
  zona   Zona   @relation(fields: [zonaId], references: [id], onDelete: Cascade)

  cuotaDesde Int
  /// null = de ahi en adelante, sin tope. El ultimo tramo tiene que ser asi o
  /// las cuotas altas quedan sin porcentaje.
  cuotaHasta Int?
  porcentaje Decimal @db.Decimal(6, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([zonaId, cuotaDesde])
  @@index([zonaId])
  @@map("escalas_agente")
}

/// La liquidacion del agente para un mes de una zona. Espejo de
/// `ComisionPeriodo`, pero la unidad es la zona y no el vendedor.
model ComisionAgentePeriodo {
  id String @id @default(cuid())

  zonaId Int
  zona   Zona @relation(fields: [zonaId], references: [id])

  /// Formato YYYY-MM.
  periodo String

  /// Contratos del mes que se comparan contra el objetivo del contrato:
  /// titulos nuevos con origen VENTA_NUEVA o RENOVACION. Los dos cuentan
  /// (Balta, 27/08/2026).
  ventasNuevas      Int @default(0)
  renovaciones      Int @default(0)
  /// Congelado al cierre: el objetivo de la zona puede cambiar despues.
  objetivoContratos Int @default(0)

  cuotasCobradas Int     @default(0)
  baseCobrada    Decimal @default(0) @db.Decimal(14, 2)
  totalComision  Decimal @default(0) @db.Decimal(14, 2)

  /// Importe manual, aparte de la comision: el club lo paga como reintegro de
  /// gastos y lo aumenta por inflacion, asi que NO se suma al total. Solo entra
  /// en el balance del mes.
  gastosRepresentacion Decimal @default(0) @db.Decimal(14, 2)

  estado      ComisionEstado @default(BORRADOR)
  fechaCierre DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  detalles ComisionAgenteDetalle[]

  @@unique([zonaId, periodo])
  @@map("comision_agente_periodos")
}

/// Un renglon de la liquidacion del agente: todas las cuotas del mes que caen
/// en el mismo tramo del contrato, con la base sumada y el porcentaje
/// congelado al cierre.
model ComisionAgenteDetalle {
  id        String                @id @default(cuid())
  periodoId String
  periodo   ComisionAgentePeriodo @relation(fields: [periodoId], references: [id], onDelete: Cascade)

  cuotaDesde Int
  cuotaHasta Int?

  cantidadCuotas     Int     @default(0)
  baseCalculo        Decimal @db.Decimal(14, 2)
  porcentajeAplicado Decimal @db.Decimal(6, 3)
  monto              Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([periodoId])
  @@map("comision_agente_detalles")
}
